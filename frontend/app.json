{
  "expo": {
    "name": "File Mind",
    "slug": "file-mind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/file-mind-icon.png",
    "scheme": "filemind",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.filemind.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan documents with your camera",
        "NSPhotoLibraryUsageDescription": "Import photos to convert and organize",
        "NSPhotoLibraryAddUsageDescription": "Save scanned documents to your library",
        "NSFaceIDUsageDescription": "Unlock your private Vault"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/file-mind-adaptive.png",
        "backgroundColor": "#FF5E00"
      },
      "package": "com.filemind.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/file-mind-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/file-mind-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF5E00"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan documents with your camera"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Import photos to convert and organize",
          "savePhotosPermission": "Save scanned documents"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private Vault"
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}